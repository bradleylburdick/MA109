            </cell>
            <cell right="medium">
              <m>8</m>
            </cell>
          </row>
          <row left="medium" bottom="medium">
            <cell right="medium">
              <m>h(x)</m>
            </cell>
            <cell right="medium">
              <m>0</m>
            </cell>
