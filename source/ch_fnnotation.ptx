            </ol>
          </p>
    </statement>
      <answer>
          <p>
      <ol>
        <li><m>f(-3)=1</m></li>
        <li><m>f(0)=2</m></li>
        <li><m>f(3)=-7</m></li>
        <li><m>f(6)=\pi</m></li>
        <li><m>f(\frac{1}{3})=4.31</m></li>
      </ol>
          </p>
          </answer><!--Statement of the answer (don't worry about location in the rendered version)-->
    </exercise><!--End of that exercise-->

      <exercise>
    <statement>
    <p>Suppose <m>f(t)</m> is given in the table below:</p>
