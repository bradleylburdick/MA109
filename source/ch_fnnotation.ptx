  <exercise>
      <statement><p>Suppose <m>a(t)= \frac{1}{19}</m>.
        <ol>
          <li>Evaluate <m>a(1)</m>.</li>
          <li>Evaluate <m>a(b+c)</m>.</li>
          <li>Evaluate <m>a(9)</m>.</li>
          <li>Evaluate <m>a(\frac{1}{19})</m>.</li>
        </ol>
      </p></statement>
      <answer><p>
        <ol>
          <li><m>a(1) = \frac{1}{19}</m></li>
          <li><m>a(b+c)) = \frac{1}{19}</m></li>
          <li><m>a(9) = \frac{1}{19}</m></li>
          <li><m>a\left(\frac{1}{19}\right) = \frac{1}{19}</m></li>
        </ol>
      </p></answer>
  </exercise>



  <exercise>
      <statement><p>Suppose <m>d(t)=\pi t</m>.
        <ol>
          <li>Evaluate <m>d(0)</m>.</li>
          <li>Evaluate <m>d(a+h)</m>.</li>
          <li>Evaluate <m>d(x)</m>.</li>
          <li>Evaluate <m>d(\sqrt{x+3})</m>.</li>
        </ol>
      </p></statement>
      <answer><p>
        <ol>
          <li><m>d(0) = 0</m></li>
          <li><m>d(a+h) = \pi a + \pi h</m></li>
          <li><m>d(x) = \pi x</m></li>
          <li><m>d(\sqrt{x+3}) = \left( \pi \right) \left( \sqrt{x+3} \right)</m></li>
        </ol>
      </p></answer>
  </exercise>

  <exercise>
    <statement>
