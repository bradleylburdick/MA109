    </table>

    <table>
      <title>Positive and Negative Values for <m>g(x)</m></title>
      <tabular>
        <row left="medium" >
          <cell right="medium" bottom="medium">
            <m>x</m>
          </cell>
          <cell right="medium" bottom="medium">
            <m>g(x)=x^3+7x+3</m>
          </cell>
          <cell right="medium">
          </cell>
          <cell right="medium" bottom="medium">
            <m>x</m>
          </cell>
          <cell right="medium" bottom="medium">
            <m>g(x)=x^3+7x+3</m>
          </cell>
        </row>
        <row left="medium" >
          <cell left="medium" right="medium" bottom="medium">
            <m>1</m>
          </cell>
          <cell right="medium" bottom="medium">
            <m>11</m>
          </cell>
          <cell right="medium">
          </cell>
          <cell right="medium" bottom="medium">
            <m>-1</m>
          </cell>
          <cell right="medium" bottom="medium">
            <m>-5</m>
          </cell>
        </row>
        <row left="medium" >
          <cell left="medium" right="medium" bottom="medium">
            <m>10</m>
          </cell>
          <cell right="medium" bottom="medium">
            <m>1,073</m>
          </cell>
          <cell right="medium">
          </cell>
